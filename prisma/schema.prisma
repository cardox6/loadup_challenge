// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id  String @id @default(cuid())
  name  String  @unique
  createdAt DateTime  @default(now())
  branches  Branch[]
  jobs  Job[]
}

model Branch {
  id  String @id @default(cuid())
  companyId String
  city  String
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  jobs  JobBranch[]

  @@unique([id, companyId])
  @@index([companyId])
}

model Job {
  id  String @id @default(cuid())
  companyId String
  title String
  templateId  String?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  template  AssessmentTemplate? @relation(fields: [templateId], references: [id])
  branches  JobBranch[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([templateId])
}

// Where a job is offered. Both foreign keys include companyId, so the database
// itself rejects linking a job to another company's branch.
model JobBranch {
  jobId String
  branchId  String
  companyId String
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Cascade)
  branch  Branch @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)

  @@id([jobId, branchId])
  @@index([branchId])
}

model Applicant {
  id  String @id @default(cuid())
  name  String
  email String
  city  String?
  createdAt DateTime @default(now())
  submissions Submission[]

  @@index([createdAt, id])
  @@index([name])
  @@index([email])
  @@index([city])
}

model AssessmentTemplate {
  id  String   @id @default(cuid())
  title String
  profileKey  String
  createdAt DateTime @default(now())
  items AssessmentItem[]
  submissions Submission[]
  jobs Job[]
}

model AssessmentItem {
  id  String @id @default(cuid())
  templateId  String
  text  String
  correctOption Int
  weight Int  @default(1)
  template  AssessmentTemplate @relation(fields: [templateId], references: [id])
  answers SubmissionAnswer[]

  @@index([templateId])
}

model Submission {
  id  String @id @default(cuid())
  applicantId String
  templateId  String
  submittedAt DateTime
  applicant Applicant @relation(fields: [applicantId], references: [id])
  template  AssessmentTemplate @relation(fields: [templateId], references: [id])
  answers SubmissionAnswer[]

  @@index([applicantId, submittedAt])
  @@index([templateId])
}

model SubmissionAnswer {
  id  String @id @default(cuid())
  submissionId  String
  itemId  String
  chosenOption  Int
  isCorrect Boolean
  itemWeight  Int
  submission  Submission @relation(fields: [submissionId], references: [id])
  item  AssessmentItem @relation(fields: [itemId], references: [id])

  @@unique([submissionId, itemId])
  @@index([itemId])
}